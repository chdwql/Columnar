{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Columnar",
  "version": "0.0.2",
  "identifier": "com.columnar.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Columnar",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "fileAssociations": [
      {
        "ext": ["csv"],
        "name": "CSV file",
        "description": "Comma-separated values file",
        "mimeType": "text/csv"
      },
      {
        "ext": ["tsv"],
        "name": "TSV file",
        "description": "Tab-separated values file",
        "mimeType": "text/tab-separated-values"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
